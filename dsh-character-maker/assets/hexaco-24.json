{
  "id": "hexaco24",
  "name": "精简版 HEXACO 量表（BHI）",
  "shortName": "HEXACO-24",
  "family": "hexaco",
  "scaleMin": 1,
  "scaleMax": 5,
  "scaleLabels": [
    "非常不同意",
    "不同意",
    "既不同意也不反对",
