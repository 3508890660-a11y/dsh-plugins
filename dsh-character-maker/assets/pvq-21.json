{
  "id": "pvq21",
  "name": "个人价值观画像问卷（PVQ-21）",
  "shortName": "施瓦茨价值观",
  "family": "values",
  "scaleMin": 1,
  "scaleMax": 6,
  "scaleLabels": [
    "完全不像我",
    "不太像我",
